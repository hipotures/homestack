[Unit]
Description=Herdr persistent terminal server

[Service]
Type=simple
ExitType=cgroup
WorkingDirectory=%h
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
# Initialize agent indirection before restoring panes; never inherit a local empty agent.
Environment=SSH_AUTH_SOCK=%h/.config/herdr/herdr.sock.agent
ExecStartPre=/usr/bin/rm -f %h/.config/herdr/herdr.sock.agent
ExecStart=%h/.local/bin/herdr server
TimeoutStartSec=5min
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target

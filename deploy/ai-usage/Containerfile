# The context holds the static homestack-usage binary built by CI
# (.github/workflows/ci.yml). Proxmox detects Alpine and configures hosts
# and resolver files, so the Prometheus host name resolves.
FROM docker.io/library/alpine:3.24.2@sha256:294b683cb724975bec92580e1e685676bd4b50bda910ddb8c51d4cabeaec77e6
COPY --chmod=0755 homestack-usage /usr/local/bin/homestack-usage
USER 10001:10001
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/homestack-usage"]

# Caddy in front of homestack-server in the node image (Containerfile,
# target node). The certificate is the one the server keeps: from the
# container's environment at the first start, later from
# PUT /v1/secrets/tls, after which the server makes Caddy load it again
# through the admin API.
{
	admin 127.0.0.1:2019
	auto_https off
}

:443 {
	tls {$HOMESTACK_STATE_DIR}/tls/cert.pem {$HOMESTACK_STATE_DIR}/tls/key.pem
	reverse_proxy 127.0.0.1:8080
}

# Private management HTTP: never forward API or secret-management routes.
:80 {
	@management path /health/live /health/ready /.well-known/homestack/status
	handle @management {
		reverse_proxy 127.0.0.1:8080
	}
	handle {
		respond 404
	}
}

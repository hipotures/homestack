#!/bin/sh
# runit service: Caddy, once the server has stored the certificate.
set -eu
exec 2>&1
. /etc/service/state-path
while [ ! -s "$HOMESTACK_STATE_DIR/tls/cert.pem" ] || [ ! -s "$HOMESTACK_STATE_DIR/tls/key.pem" ]; do
    sleep 1
done
exec caddy run --config /etc/caddy/Caddyfile --adapter caddyfile

# The builder release, Go toolchain and Alpine runtime are pinned by digest.
FROM docker.io/otel/opentelemetry-collector-builder:0.163.0@sha256:ad0755b2cffdfb5204a94ba464ad3843f552254c4cdd6d9a638046a1e13ca179 AS build
COPY builder-config.yaml .
RUN ocb --config=builder-config.yaml

# Proxmox detects Alpine and supplies hosts/resolver configuration through its
# existing setup plugin. A scratch-only rootfs is unmanaged and skips DNS setup.
# No init system is needed: the static Collector binary remains PID 1.
FROM docker.io/library/alpine:3.24.2@sha256:294b683cb724975bec92580e1e685676bd4b50bda910ddb8c51d4cabeaec77e6
RUN mkdir -p /var/lib/otelcol/queue \
    && chown 10001:10001 /var/lib/otelcol/queue \
    && chmod 0700 /var/lib/otelcol/queue
COPY --from=build --chmod=0755 /home/ocb/_build/otelcol-homestack /otelcol-homestack
COPY --chmod=0444 collector.yaml /etc/otelcol/homestack.yaml
USER 10001:10001
EXPOSE 4317 4318 13133
ENTRYPOINT ["/otelcol-homestack"]
CMD ["--config=/etc/otelcol/homestack.yaml"]

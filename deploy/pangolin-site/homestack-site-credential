#!/bin/sh
# Receives this connector's Site configuration on standard input and keeps it
# readable only by the connector's account. With --digest it prints only the
# SHA-256 of the installed file, so HomeStack can compare without reading it.
set -eu
. /usr/local/lib/homestack-site-state
file="$dir/site.json"
if [ "${1:-}" = --digest ]; then
    if [ -f "$file" ]; then sha256sum "$file" | cut -d' ' -f1; else echo missing; fi
    exit 0
fi
umask 077
tmp=$(mktemp "$dir/.site.json.XXXXXX")
trap 'rm -f "$tmp"' EXIT
head -c 4096 > "$tmp"
[ -s "$tmp" ]
chown site:nogroup "$tmp"
chmod 0600 "$tmp"
sync
mv -f "$tmp" "$file"
trap - EXIT
sync
sv restart /etc/service/site >/dev/null

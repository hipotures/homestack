# Build context: repository root. The application builds natively on Alpine musl.
FROM docker.io/library/rust:1.99.0-alpine@sha256:0cce0a5e0e8ba67b455257a3a02a1d99005f382748789d6464460028810f1627 AS build
RUN apk add --no-cache musl-dev binutils
WORKDIR /src
COPY . .
ARG HOMESTACK_METRICS_VERSION
# An explicit target keeps static linking off the host proc-macros.
RUN RUSTFLAGS="-C target-feature=+crt-static" cargo build --release --locked --target x86_64-unknown-linux-musl \
        -p hs-metrics --bin homestack-metrics \
    && ! readelf -l target/x86_64-unknown-linux-musl/release/homestack-metrics | grep -q INTERP
# Proxmox detects Alpine and configures hosts and resolver files, so the
# Prometheus host name resolves.
FROM docker.io/library/alpine:3.24.2@sha256:294b683cb724975bec92580e1e685676bd4b50bda910ddb8c51d4cabeaec77e6
COPY --from=build --chmod=0755 /src/target/x86_64-unknown-linux-musl/release/homestack-metrics /usr/local/bin/homestack-metrics
# Port 80 needs root; the unprivileged LXC maps it to an unprivileged host user.
ENV HOMESTACK_LISTEN=0.0.0.0:80
EXPOSE 80
ENTRYPOINT ["/usr/local/bin/homestack-metrics"]

FROM docker.io/library/alpine:3.24.2@sha256:294b683cb724975bec92580e1e685676bd4b50bda910ddb8c51d4cabeaec77e6 AS runtime-download
RUN apk add --no-cache curl tar
ARG CODEX_VERSION=0.166.0
ARG CODEX_SHA256=a0bf572d2f93f056c6712a6da348e96078dc84f3885fd7be67807ef389cb3978
RUN curl -fsSL "https://github.com/openai/codex/releases/download/rust-v${CODEX_VERSION}/codex-x86_64-unknown-linux-musl.tar.gz" -o /codex.tar.gz \
    && echo "${CODEX_SHA256}  /codex.tar.gz" | sha256sum -c - \
    && mkdir /runtime && tar -xzf /codex.tar.gz -C /runtime \
    && mv /runtime/codex-x86_64-unknown-linux-musl /runtime/codex \
    && /runtime/codex --version
FROM runtime-download AS antigravity-download
ARG ANTIGRAVITY_VERSION=1.5.0
ARG ANTIGRAVITY_SHA256=feab046295c80f156a8e1d39135c362f3f4e7397259b2999b4725134b3dde955
RUN curl -fsSL "https://github.com/google-antigravity/antigravity-cli/releases/download/${ANTIGRAVITY_VERSION}/agy_cli_linux_x64_musl.tar.gz" -o /agy.tar.gz \
    && echo "${ANTIGRAVITY_SHA256}  /agy.tar.gz" | sha256sum -c - \
    && tar -xzf /agy.tar.gz -C /runtime antigravity && /runtime/antigravity --version
FROM docker.io/library/alpine:3.24.2@sha256:294b683cb724975bec92580e1e685676bd4b50bda910ddb8c51d4cabeaec77e6 AS claude-download
RUN apk add --no-cache curl
ARG CLAUDE_VERSION=2.1.318
ARG CLAUDE_SHA256=e6ff03823153a699d708c88c2fa87d18a1f6b45f13b14a985a221f8af442dd54
RUN curl -fsSL "https://downloads.claude.ai/claude-code-releases/${CLAUDE_VERSION}/linux-x64-musl/claude" -o /claude \
    && echo "${CLAUDE_SHA256}  /claude" | sha256sum -c - && chmod 0755 /claude
FROM docker.io/library/alpine:3.24.2@sha256:294b683cb724975bec92580e1e685676bd4b50bda910ddb8c51d4cabeaec77e6 AS helper
RUN apk add --no-cache nodejs npm
WORKDIR /helper
COPY claude-probe/package*.json ./
RUN npm ci --omit=optional --ignore-scripts && npm cache clean --force
COPY claude-probe/probe.mjs ./probe.mjs
FROM docker.io/library/alpine:3.24.2@sha256:294b683cb724975bec92580e1e685676bd4b50bda910ddb8c51d4cabeaec77e6
RUN apk add --no-cache ca-certificates util-linux-misc tini nodejs bash libgcc libstdc++ ripgrep \
    && addgroup -g 10001 app && adduser -D -u 10001 -G app app \
    && mkdir -p /home/app && chown app:app /home/app && chmod 0700 /home/app
COPY --from=runtime-download /runtime/codex /opt/agent-accounts/codex
COPY --from=antigravity-download /runtime/antigravity /opt/agent-accounts/antigravity
COPY --from=claude-download /claude /opt/agent-accounts/claude
COPY --from=helper /helper /opt/agent-accounts/claude-probe
COPY --chmod=0755 homestack-agent-accounts /usr/local/bin/homestack-agent-accounts
ENV HOMESTACK_LISTEN=0.0.0.0:8080
USER 10001:10001
EXPOSE 8080
ENTRYPOINT ["/sbin/tini", "-g", "--", "/usr/local/bin/homestack-agent-accounts"]

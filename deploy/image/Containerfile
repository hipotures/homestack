# The node image from a server binary built outside Docker (CI builds it
# with its Rust cache, so an image takes about a minute, not ten). The
# context is a directory holding homestack-server, Caddyfile and service/
# (.github/workflows/rust-migration.yml); the result is the same as the
# node target of the repository's Containerfile.
FROM docker.io/library/alpine:3.24.2
RUN apk add --no-cache ca-certificates caddy runit \
    && adduser -S -D -H -h /var/lib/homestack -s /sbin/nologin homestack \
    && install -d -m 0700 -o homestack -g nogroup /var/lib/homestack
COPY homestack-server /usr/local/bin/homestack-server
COPY Caddyfile /etc/caddy/Caddyfile
COPY service /etc/service
EXPOSE 443
STOPSIGNAL SIGTERM
ENTRYPOINT ["runsvdir", "-P", "/etc/service"]

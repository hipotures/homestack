#!/usr/bin/env bash
# Shared entrypoint for SSH clients and systemd services. Exporters live in
# ~/.claude/settings.json and ~/.codex/config.toml, never in shell profiles.
set -euo pipefail

agent=${0##*/}
if [[ "$agent" == agent-start ]]; then
    agent=${1:?Usage: agent-start claude|codex [arguments...]}
    shift
fi
case "$agent" in
    claude|codex) ;;
    *) printf 'Unsupported agent: %s\n' "$agent" >&2; exit 2 ;;
esac

# Discard stale settings inherited from a terminal or a restored Herdr pane.
for variable in ${!OTEL_@}; do
    unset "$variable"
done
IFS= read -r instance < /proc/sys/kernel/random/uuid
export OTEL_EXPORTER_OTLP_METRICS_TEMPORALITY_PREFERENCE=cumulative
OTEL_RESOURCE_ATTRIBUTES="host.name=$(hostname),service.instance.id=$instance"
export OTEL_RESOURCE_ATTRIBUTES

if [[ "$agent" == claude ]]; then
    # Remote Control workers inherit the server's repository, including when
    # it creates linked worktrees. An SSH launch in a linked worktree uses
    # the main repository name as well.
    if common=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null); then
        if [[ "${common##*/}" == .git ]]; then
            project=$(basename "$(dirname "$common")")
        else
            project=$(basename "$(git rev-parse --show-toplevel)")
        fi
        # Encode separators and whitespace in resource attribute values.
        project=$(python3 -c 'import sys, urllib.parse; print(urllib.parse.quote(sys.argv[1], safe="-._~"))' "$project")
        export OTEL_RESOURCE_ATTRIBUTES="$OTEL_RESOURCE_ATTRIBUTES,project=$project"
    fi
fi

# Keep the native installers' symlinks intact so agent updates keep working.
exec "$HOME/.local/bin/$agent" "$@"
